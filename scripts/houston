#!/usr/bin/env bash
# Radio Houston from a shell, CI job or cron.
#   houston "Build finished" "web · main · 4m12s" success
#   houston --json '{"key":"deploy","title":"Deploying","kind":{"type":"progress","value":0.4}}'
#   houston --remove deploy
# Severity: success | info | warning | critical. HOUSTON_KEY overrides the key.
set -euo pipefail
CONFIG="$HOME/Library/Application Support/houston/config.json"
read -r PORT TOKEN < <(/usr/bin/python3 -c 'import json,sys; c=json.load(open(sys.argv[1]))["api"]; print(c.get("port",7878), c["token"])' "$CONFIG")
URL="http://127.0.0.1:$PORT/v1/islands"
auth=(-H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json")

case "${1:-}" in
  --json) exec curl -fsS -X POST "${auth[@]}" --data "$2" "$URL" ;;
  --remove) exec curl -fsS -X DELETE "${auth[@]}" "$URL/$(/usr/bin/python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$2")" ;;
  ""|-h|--help) sed -n '2,6p' "$0"; exit 0 ;;
esac

body=$(/usr/bin/python3 - "$@" <<'PY'
import json, os, sys
title = sys.argv[1]
subtitle = sys.argv[2] if len(sys.argv) > 2 else None
severity = sys.argv[3] if len(sys.argv) > 3 else "info"
icon = {"success": "✅", "info": "🔔", "warning": "⚠️", "critical": "🚨"}.get(severity, "🔔")
print(json.dumps({"key": os.environ.get("HOUSTON_KEY", os.environ.get("NOTCH_KEY", title)), "title": title,
                  "subtitle": subtitle, "severity": severity, "icon": icon}))
PY
)
curl -fsS -X POST "${auth[@]}" --data "$body" "$URL"
